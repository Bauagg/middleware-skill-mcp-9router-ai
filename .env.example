# App
APP_ENV=development
GIN_MODE=debug
PORT=4000
BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=middleware_skill_ai
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Upload
PATH_FILE_UPLOAD=skills

# Threshold skor BM25 pemilih skill: skill dengan skor di bawah ini tidak disisipkan.
# Naikkan bila skill sering salah terpilih, turunkan bila jarang terpilih.
# Cek skor sebenarnya lewat GET /api/skills/match?q=...
SKILL_MIN_SCORE=2.0

# Skill aktif sebuah percakapan baru diganti bila skor skill lain minimal sekian kali
# skor skill aktif untuk pesan yang sama (>= 1).
SKILL_SWITCH_RATIO=1.5

# Budget token skill per model. Skill yang melebihi budget diganti SHORT.md, atau dipotong
# bila tidak ada. SKILL_BUDGETS berformat pola=token (huruf besar/kecil tidak dibedakan,
# * = wildcard), aturan pertama yang cocok dipakai. 0 pada default = tanpa batas.
SKILL_BUDGET_DEFAULT=3000
SKILL_BUDGETS=*mini*=800,*haiku*=800,*flash*=800

# Cache di Redis. Masa berlaku skill aktif per percakapan dan cache hasil seleksi.
SKILL_SESSION_TTL=45m
SKILL_SELECTION_TTL=1h

# Seberapa sering folder skill diperiksa untuk reload otomatis (0 = dimatikan).
SKILL_WATCH_INTERVAL=5s

# Redis untuk cache (wajib). Server tidak berjalan bila REDIS_ADDR kosong atau Redis
# tidak terjangkau saat start.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Batas waktu tiap operasi Redis. 200ms untuk Redis satu mesin/jaringan dengan server;
# perbesar (mis. 2s) bila Redis jauh, misalnya Redis DEV di VPS dipakai dari komputer lokal.
REDIS_TIMEOUT=200ms

# 9Router: alamat, key, dan model TIDAK diisi di sini. Middleware hanya alat di depan
# 9Router milik user: setiap user mengirim alamat 9Router-nya di header X-Router-URL
# (mis. https://domain-9router/v1), key di X-Router-Key, dan model di field "model".
# Izinkan alamat 9Router di jaringan internal (localhost, 10.x, 192.168.x, ...)? Bawaan
# false: alamat kiriman client tidak boleh dipakai menembus layanan internal server
# (Redis, PostgreSQL, metadata cloud). true hanya untuk pengembangan lokal.
ROUTER_ALLOW_PRIVATE_NETWORK=false


# Pemilih cadangan: dipanggil HANYA saat skor seleksi ambigu (dua skill
# bersaing ketat, atau skor teratas sedikit di bawah threshold). Memakai model dan key
# milik user yang sedang chat (dibayar akun 9Router user). false = dimatikan.
# Setiap panggilan menambah latensi (beberapa detik) dan memakai token; keputusannya di-cache.
SKILL_FALLBACK_ENABLED=true
SKILL_FALLBACK_TIMEOUT=5s
# Skill lain dianggap bersaing bila skor BM25-nya >= rasio ini x skor teratas (0-1).
SKILL_AMBIGUOUS_RATIO=0.8

# Embedding (Tahap 3): seleksi berdasarkan makna, bukan kata persis. Kosong = memakai BM25.
# Bila EMBEDDING_MODEL diisi, layanan embedding wajib terjangkau saat start.
# EMBEDDING_BASE_URL wajib diisi bila EMBEDDING_MODEL diisi (tidak ada 9Router tetap)
# (mis. Ollama: http://localhost:11434/v1, model bge-m3).
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=2s
# Threshold dan margin untuk skor kemiripan (-1..1); perlu disetel per model embedding.
SKILL_MIN_SIMILARITY=0.5
SKILL_SWITCH_MARGIN=0.05
SKILL_AMBIGUOUS_MARGIN=0.03

# Eval skill. Model dikirim di body POST /api/evals/runs ("model", opsional "judge_model")
# dan key 9Router di header X-Router-Key.
EVAL_CONCURRENCY=3

# Memori (Tahap 4). Context pack (m_context_packs) selalu disisipkan setelah
# skill; catatan memori (t_memory_notes) hanya yang cocok dengan pesan user.
# Batas token gabungan context pack aktif (0 = tanpa batas).
CONTEXT_PACK_MAX_TOKENS=800
# Catatan maksimal per request (0 = penyisipan catatan dimatikan).
MEMORY_MAX_NOTES=2
# Batas token per catatan di prompt.
MEMORY_NOTE_MAX_TOKENS=150
# Kata pesan minimal yang harus ada di catatan supaya dianggap cocok.
MEMORY_MIN_MATCH=2
# Batas waktu pencarian catatan per request; lewat = jalan tanpa catatan.
MEMORY_LOOKUP_TIMEOUT=300ms
# Masa berlaku catatan sejak dikonfirmasi (2160h = 90 hari, 0 = selamanya).
MEMORY_NOTE_TTL=2160h
# Ekstraksi catatan otomatis dari pesan yang memuat sinyal hasil
# (berhasil, gagal, omzet, ...). Memakai model dan key user yang sedang chat.
# false = ekstraksi dimatikan (catatan manual tetap bisa).
MEMORY_EXTRACT_ENABLED=true
# Batas waktu satu ekstraksi dan berapa yang boleh berjalan bersamaan.
MEMORY_EXTRACT_TIMEOUT=60s
MEMORY_EXTRACT_CONCURRENCY=2

# Docker (dipakai docker-compose.yml, bukan oleh aplikasi).
# Alamat dan port di VPS tempat middleware dibuka. Bawaan hanya dari VPS sendiri
# (127.0.0.1), karena API /api/* tanpa autentikasi; buka ke publik lewat NGINX.
DOCKER_PORT_BIND=127.0.0.1:4000
# Nama image. Isi dengan image dari registry bila build dilakukan CI/CD.
DOCKER_IMAGE=middleware-skill-ai:latest

# MCP (Figma, Canva, dll.). 9Router tidak bisa memakai MCP, jadi middleware yang
# terhubung ke server MCP lalu menjalankan tool yang diminta model.
# Daftar server ada di file ini; file tidak ada = MCP dimatikan. Perubahan butuh restart.
MCP_CONFIG_PATH=mcp.json
# Kunci enkripsi token login MCP di database (64 karakter hex, buat dengan:
# openssl rand -hex 32). Wajib bila ada server aktif. Jangan diganti setelah
# login: token lama tidak bisa dibaca dan harus login ulang.
MCP_TOKEN_KEY=your_64_hex_key
# Tool maksimal yang dikirim ke model per request (0 = tool tidak dipakai di chat).
MCP_MAX_TOOLS=8
# Skor BM25 minimal sebuah tool supaya dikirim; cek lewat GET /api/mcp/tools?q=...
MCP_TOOL_MIN_SCORE=1.0
# Putaran panggil-tool maksimal per request.
MCP_MAX_STEPS=6
# Batas waktu satu pemanggilan tool.
MCP_TOOL_TIMEOUT=60s
# Batas token hasil satu tool yang diberikan ke model.
MCP_TOOL_RESULT_MAX_TOKENS=4000
# Seberapa sering daftar tool diambil ulang (0 = hanya saat start dan login).
MCP_REFRESH_INTERVAL=30m

# Pasang MCP dari GitHub lewat chat. Repo diunduh ke MCP_REPOS_PATH untuk diperiksa,
# pengajuan user biasa harus disetujui admin, data rahasia (password/DSN) diisi lewat
# link form (terenkripsi MCP_TOKEN_KEY), lalu server dijalankan di container Docker
# terpisah (tanpa hak istimewa, dibatasi memori/CPU) di network MCP_DOCKER_NETWORK.
# Folder clone repo.
MCP_REPOS_PATH=open_source_mcp
# Alamat Docker API. Kosong = fitur mati. Di docker-compose otomatis
# tcp://docker-proxy:2375 (proxy yang hanya membuka urusan container). Di laptop:
# Docker Desktop > Settings > General > "Expose daemon on tcp://localhost:2375",
# lalu isi tcp://localhost:2375 dan buat network-nya: docker network create middleware_mcp_net
MCP_DOCKER_HOST=
# Network khusus container MCP (dibuat docker-compose).
MCP_DOCKER_NETWORK=middleware_mcp_net
# Image runner (git, Node 22, pnpm, Python, uv, supergateway), dibangun docker-compose
# dari docker/mcp-runner. Di laptop: docker build -t middleware-mcp-runner:latest docker/mcp-runner
MCP_RUNNER_IMAGE=middleware-mcp-runner:latest
# Kosong = container dijangkau lewat namanya di network (middleware di Docker).
# Isi 127.0.0.1 bila middleware berjalan di luar Docker (go run di laptop).
MCP_RUNNER_PUBLISH_HOST=
# Batas per container MCP: memori (MB), CPU, dan waktu clone + install sampai siap.
MCP_RUNNER_MEMORY_MB=1024
MCP_RUNNER_CPUS=1
MCP_RUNNER_START_TIMEOUT=10m

# Pembuat gambar lewat chat (tool generate_image). Model menawarkan tool ini
# hanya bila pesan menyinggung gambar; gambar disimpan di IMAGE_PATH dan tampil
# di chat lewat BASE_URL/images/<nama>. Model gambar TIDAK diisi di sini: diambil
# otomatis dari akun 9Router user (GET /v1/models/image) dan dicoba berurutan; model
# yang menolak dilewati sementara (akun tidak berhak 30 menit, server penuh 2 menit).
# Akun yang belum punya model gambar tidak ditawari tool ini.
# Ukuran gambar dan batas waktu membuat satu gambar.
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT=2m
# Folder penyimpanan gambar (dibuat otomatis).
IMAGE_PATH=images


# Pencarian web lewat SearXNG (tool web_search di chat): mencari skill, pesaing,
# tren, berita, dll. SearXNG dijalankan sendiri (service "searxng" di
# docker-compose.yml). Kosong = web search mati. Di Docker otomatis
# http://searxng:8080; di laptop bisa http://localhost:8888 bila container jalan.
WEB_SEARCH_URL=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT=15s
# Kunci rahasia SearXNG (acak, mis. openssl rand -hex 32). Dipakai container searxng.
SEARXNG_SECRET=your_random_hex_secret

# Secret key aplikasi client (wajib). Setiap request ke middleware harus membawa
# header X-API-Key berisi salah satu key ini. Boleh lebih dari satu dipisah koma
# (mis. satu key per aplikasi, atau key lama + baru saat ganti key). Minimal 32
# karakter, buat dengan: openssl rand -hex 32. Yang tidak butuh key: /health,
# /images/..., dan alur login MCP yang dibuka browser.
API_KEYS=your_api_key_min_32_chars

# Akun login (register/login/refresh di /api/auth) untuk user yang tidak datang
# dari aplikasi pihak ketiga. Mereka memakai header Authorization: Bearer <access_token>
# sebagai pengganti X-API-Key + X-User-Id.
# Kunci tanda tangan token (wajib, minimal 32 karakter: openssl rand -hex 32).
# Mengganti nilai ini membuat semua token lama tidak berlaku (semua user login ulang).
JWT_SECRET=your_jwt_secret_min_32_chars
# Umur access token dan refresh token (720h = 30 hari).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Akun admin (pemilik aplikasi): dibuat saat start bila belum ada. Admin melihat data
# semua user (context pack, catatan, gambar, log, eval, MCP); register biasa selalu role
# user. Akun yang sudah ada dengan email ini hanya dijadikan admin bila password-nya sama.
# Kosong = tidak membuat admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
